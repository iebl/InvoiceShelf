<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
    <!--
      End-to-end conformance proof: needs a real Gotenberg service plus the
      Mustang and veraPDF validators, so it is excluded from every ordinary run
      by the `conformance` group below and only selected explicitly, by the CI
      job that provisions those tools (.github/workflows/einvoice-conformance.yaml).
    -->
    <testsuite name="Conformance">
      <directory suffix="Test.php">./tests/Conformance</directory>
    </testsuite>
  </testsuites>
  <groups>
    <exclude>
      <group>conformance</group>
    </exclude>
  </groups>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <env name="CACHE_STORE" value="array"/>
    <env name="DB_CONNECTION" value="sqlite"/>
    <env name="DB_DATABASE" value=":memory:"/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="APP_URL" value="http://invoiceshelf.test"/>
  </php>
    <groups>
        <exclude>
            <group>isolated</group>
        </exclude>
    </groups>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
